# Copy to .env on the VM, run chmod 600 .env, and replace every CHANGE_ME value.
# App images must use the exact Git commit SHA, never latest.
OFFICEFLOW_API_IMAGE=officeflow-api:CHANGE_ME_COMMIT_SHA
OFFICEFLOW_WEB_IMAGE=officeflow-web:CHANGE_ME_COMMIT_SHA
OFFICEFLOW_TUNNEL_PORT=8080

POSTGRES_DB=officeflow_test
POSTGRES_USER=officeflow_test
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
MEETINGHQ_JWT_SECRET=CHANGE_ME_RANDOM_64_HEX_CHAR_SECRET

INITIAL_SUPER_ADMIN_EMAIL=CHANGE_ME_TEST_ADMIN_EMAIL
INITIAL_SUPER_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_TEMPORARY_PASSWORD
INITIAL_SUPER_ADMIN_FIRST_NAME=Test
INITIAL_SUPER_ADMIN_LAST_NAME=Administrator
INITIAL_ORGANIZATION_NAME=OfficeFlow Test
INITIAL_WORKSPACE_NAME=Test Workspace
