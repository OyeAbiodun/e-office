# Runtime
MEETINGHQ_ENVIRONMENT=local
MEETINGHQ_LOG_LEVEL=INFO
MEETINGHQ_API_HOST=0.0.0.0
MEETINGHQ_API_PORT=8000
MEETINGHQ_RUN_MIGRATIONS=true
MEETINGHQ_API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]

# PostgreSQL
POSTGRES_DB=meetinghq
POSTGRES_USER=meetinghq
POSTGRES_PASSWORD=meetinghq_dev_only
MEETINGHQ_DATABASE_URL=postgresql+asyncpg://meetinghq:meetinghq_dev_only@postgres:5432/meetinghq

# Redis
MEETINGHQ_REDIS_URL=redis://redis:6379/0

# JWT infrastructure (replace in every deployed environment)
MEETINGHQ_JWT_SECRET=replace-with-at-least-32-random-characters
MEETINGHQ_JWT_ALGORITHM=HS256
MEETINGHQ_JWT_ACCESS_TOKEN_TTL_MINUTES=15
MEETINGHQ_REFRESH_TOKEN_TTL_DAYS=30
MEETINGHQ_JWT_ISSUER=meetinghq
MEETINGHQ_JWT_AUDIENCE=meetinghq-api
MEETINGHQ_REFRESH_COOKIE_NAME=meetinghq_refresh
MEETINGHQ_CSRF_COOKIE_NAME=meetinghq_csrf
MEETINGHQ_SECURE_COOKIES=false
MEETINGHQ_PASSWORD_RESET_TTL_MINUTES=30
MEETINGHQ_EMAIL_VERIFICATION_TTL_HOURS=24
MEETINGHQ_LOGIN_MAX_FAILURES=5
MEETINGHQ_LOGIN_LOCK_MINUTES=15
MEETINGHQ_AUTH_RATE_LIMIT_REQUESTS=10
MEETINGHQ_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Required permanent first-run installation bootstrap
# These are read only when no Organization exists and are never reapplied.
INITIAL_SUPER_ADMIN_EMAIL=textabi12@gmail.com
INITIAL_SUPER_ADMIN_PASSWORD=ChangeMe123!
INITIAL_SUPER_ADMIN_FIRST_NAME=Abiodun
INITIAL_SUPER_ADMIN_LAST_NAME=
INITIAL_ORGANIZATION_NAME=MeetingHQ
INITIAL_WORKSPACE_NAME=Main Workspace

# Storage and invitations
MEETINGHQ_STORAGE_PROVIDER=local
MEETINGHQ_LOCAL_STORAGE_PATH=./storage
MEETINGHQ_PUBLIC_STORAGE_URL=/api/v1/storage
MEETINGHQ_INVITATION_TTL_DAYS=7

# Transactional email delivery and meeting reminders
# These settings deliver invitations, password reset messages, and reminders.
# User mailbox providers are configured only through Integration Center.
# Leave SMTP host empty for local development; RFC-compliant .eml messages
# (including ICS invitations) are written to MEETINGHQ_EMAIL_OUTBOX_PATH.
MEETINGHQ_SMTP_HOST=
MEETINGHQ_SMTP_PORT=587
MEETINGHQ_SMTP_USERNAME=
MEETINGHQ_SMTP_PASSWORD=
MEETINGHQ_SMTP_FROM_EMAIL=meetings@meetinghq.local
MEETINGHQ_SMTP_STARTTLS=true
MEETINGHQ_EMAIL_OUTBOX_PATH=./storage/outbox
MEETINGHQ_REMINDER_POLL_SECONDS=30
# Set false when a dedicated worker/job invokes `python -m meetinghq_api.worker`.
MEETINGHQ_EMBEDDED_REMINDER_WORKER=true

# Web
VITE_API_URL=http://localhost:8000/api/v1
